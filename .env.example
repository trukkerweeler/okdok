# Copy this file to .env and fill in real values
# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=changeme
DB_NAME=okdok
# API / App
PORT=3002
API_URL=
# Session
SESSION_SECRET=replace-with-a-secure-random-value
SESSION_MAX_AGE_DAYS=30
# Login (required to access the app)
AUTH_USER=your-username
AUTH_PASS=replace-with-a-secure-password
# SMTP (for email features)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OKDOK <noreply@example.com>"
# Optional: paths used by the server
TRAINING_FILES_PATH=
INPUT_FILES_PATH=
DOCUMENT_FILES_PATH=
DEVICE_IMAGES_PATH=
EQUIPMENT_IMAGES_PATH=
